{
  "name": "SavedWord",
  "type": "object",
  "properties": {
    "definition": {
      "type": "string",
      "description": "captured at save time, stays stable even if a pool definition later changes"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "default": "curated",
      "enum": [
        "curated",
        "external"
      ],
      "description": "curated = from VIRORA's own vocab pools (all v1 saves). external reserved for a future live-lookup fallback \u2014 not used yet."
    },
    "source_lesson_id": {
      "type": "string",
      "description": "references Lesson.id, nullable \u2014 which lesson this was encountered in, if applicable"
    },
    "user_email": {
      "type": "string"
    },
    "word": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "word",
    "definition"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}