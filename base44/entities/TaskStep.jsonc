{
  "name": "TaskStep",
  "type": "object",
  "properties": {
    "step_code": {
      "type": "string",
      "description": "Human-readable step ID: VT-14.2#5."
    },
    "task_id": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Instructions: what exactly to do."
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "failed",
        "skipped"
      ],
      "default": "todo"
    },
    "expected_result": {
      "type": "string"
    },
    "actual_result": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "last_actor": {
      "type": "string"
    }
  },
  "required": [
    "step_code",
    "task_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
