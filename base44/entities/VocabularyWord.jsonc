{
  "name": "VocabularyWord",
  "type": "object",
  "properties": {
    "unit_key": {
      "type": "string",
      "description": "Unit identifier e.g. unit1, unit2"
    },
    "unit_name": {
      "type": "string",
      "description": "Display name e.g. Unit 1: People and Places"
    },
    "unit_number": {
      "type": "number",
      "description": "Numeric order for sorting"
    },
    "uzbek": {
      "type": "string"
    },
    "russian": {
      "type": "string",
      "description": "Russian translation"
    },
    "english": {
      "type": "string"
    },
    "pronunciation": {
      "type": "string",
      "description": "Phonetic pronunciation e.g. /\u02c8pi\u02d0pl/"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    }
  },
  "required": [
    "unit_key",
    "unit_name",
    "uzbek",
    "english"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}