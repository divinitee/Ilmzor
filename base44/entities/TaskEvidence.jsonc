{
  "name": "TaskEvidence",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "owner_code": {
      "type": "string",
      "description": "task_code or step_code of the record this evidence is attached to."
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "screenshot",
        "log",
        "api_response",
        "test_output",
        "file",
        "link",
        "checkpoint"
      ],
      "default": "note"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "URL, file path, commit hash, checkpoint ID, or pasted output."
    },
    "captured_by": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
