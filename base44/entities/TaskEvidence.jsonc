{
  "name": "TaskEvidence",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "screenshot",
        "log",
        "api_response",
        "test_output",
        "file",
        "link",
        "note"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "ref": {
      "type": "string",
      "description": "Path or URL reference."
    },
    "captured_by": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "never"
      }
    }
  }
}