{
  "name": "SkillState",
  "type": "object",
  "description": "VT-6. DERIVED current standing of one learner in one skill. Recomputed server-side by base44/shared/progressEngine.ts from the skill's OWN evidence (WordAttempt for vocabulary/spelling, GrammarAttempt for grammar, AiGradedItem for comprehension/creativity), plus pre-VT-6 RewardEvent rounds as a flagged legacy tier that only fills the window when fewer than EVIDENCE_WINDOW_N verified rounds exist. RewardEvent is never mastery evidence for post-VT-6 rounds. Written ONLY by progressApi.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "skill": {
      "type": "string",
      "enum": [
        "vocabulary",
        "grammar",
        "spelling",
        "comprehension",
        "creativity"
      ]
    },
    "current_mastery": {
      "type": "number",
      "default": 0,
      "description": "0-100. Item credit / items presented across the window."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low",
      "description": "From verified_rounds only. Never alters mastery."
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "cold"
      ],
      "default": "cold",
      "description": "Re-derived on every read."
    },
    "round_count": {
      "type": "number",
      "default": 0,
      "description": "All rounds of evidence (verified + legacy)."
    },
    "verified_rounds": {
      "type": "number",
      "default": 0,
      "description": "Rounds of server-validated post-VT-6 evidence."
    },
    "legacy_rounds_in_window": {
      "type": "number",
      "default": 0,
      "description": "How many of the window's rounds are legacy client-written history."
    },
    "items_in_window": {
      "type": "number",
      "default": 0
    },
    "evidence_count": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED alias of round_count, kept so older cached clients keep rendering."
    },
    "last_evidence_at": {
      "type": "string",
      "format": "date-time"
    },
    "historical_peak": {
      "type": "number",
      "default": 0,
      "description": "Server-derived lifetime max of current_mastery, replayed from the ledgers. Never read from SkillHubProgress."
    },
    "legacy_best": {
      "type": "number",
      "default": 0,
      "description": "Frozen copy of the old client-written SkillHubProgress.best. Display-only history; never feeds mastery or historical_peak."
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Storage only."
    }
  },
  "required": [
    "user_email",
    "skill"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}