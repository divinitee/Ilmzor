{
  "name": "Task",
  "properties": {
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "archived_at": {
      "format": "date-time",
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "depends_on": {
      "description": "Task codes this task depends on.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "description": "YYYY-MM-DD",
      "type": "string"
    },
    "focus_rank": {
      "default": 0,
      "description": "Position on the Focus roadmap: 1 = the task being worked on now, 2+ = up next in order, 0 = not on the roadmap (backlog).",
      "type": "integer"
    },
    "last_actor": {
      "type": "string"
    },
    "launch_blocker": {
      "default": false,
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "order": {
      "default": 0,
      "type": "integer"
    },
    "parent_id": {
      "description": "Parent Task.id. Empty for root (big) tasks.",
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "raw_idea",
      "enum": [
        "raw_idea",
        "planned",
        "in_progress",
        "complete"
      ],
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "task_code": {
      "description": "Human-readable hierarchical ID: VT-14, VT-14.2, VT-14.2.1. A child's code is its parent's code plus a dot and a number.",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    }
  },
  "required": [
    "task_code",
    "title",
    "status",
    "priority"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}