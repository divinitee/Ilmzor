{
  "name": "Task",
  "type": "object",
  "properties": {
    "task_code": {
      "type": "string",
      "description": "Human-readable hierarchical ID: VT-14, VT-14.2, VT-14.2.1. A child's code is its parent's code plus a dot and a number."
    },
    "parent_id": {
      "type": "string",
      "description": "Parent Task.id. Empty for root (big) tasks."
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "raw_idea",
        "planned",
        "in_progress",
        "complete"
      ],
      "default": "raw_idea"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task codes this task depends on."
    },
    "notes": {
      "type": "string"
    },
    "launch_blocker": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "last_actor": {
      "type": "string"
    }
  },
  "required": [
    "task_code",
    "title",
    "status",
    "priority"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
