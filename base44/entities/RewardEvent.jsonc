{
  "name": "RewardEvent",
  "type": "object",
  "description": "XP ledger: one row per completed round that awards XP. Written only by progressApi.submitReward. Rows with ledger_version 2 are post-correction and are XP ONLY - never mastery evidence. Rows without ledger_version are pre-correction client-reported history, used by SkillState only as a flagged legacy tier that fills the window while fewer than 10 verified rounds exist.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "XP awarded after modifiers."
    },
    "round_id": {
      "type": "string"
    },
    "items_total": {
      "type": "number"
    },
    "items_correct": {
      "type": "number"
    },
    "base_xp": {
      "type": "number"
    },
    "streak_best": {
      "type": "number"
    },
    "hint_multiplier": {
      "type": "number"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "ledger_version": {
      "type": "number",
      "description": "2 = post-correction XP-only row. Absent = legacy."
    }
  },
  "required": [
    "user_email",
    "game",
    "amount",
    "round_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}