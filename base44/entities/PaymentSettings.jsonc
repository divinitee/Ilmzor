{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "qr_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for the Humo/Uzcard QR payment option."
    },
    "qr_image_url": {
      "type": "string",
      "description": "Public URL of the payment QR image students scan."
    },
    "qr_payload": {
      "type": "string",
      "description": "The raw text inside the bank QR (EMV string decoded from the uploaded image). /pay/qr redraws it in the plan's style. Admin-set only: payments go wherever this text points."
    },
    "recipient_name": {
      "type": "string",
      "description": "Name shown under the QR so the student can check who they are paying."
    },
    "telegram_handle": {
      "type": "string",
      "description": "Support handle without @, shown on the QR page."
    },
    "activation_hours": {
      "type": "number",
      "description": "Usual time to activate after a receipt, shown to students. Only promise what you can keep."
    },
    "price_uzs_learner_monthly": {
      "type": "number"
    },
    "price_uzs_learner_yearly": {
      "type": "number"
    },
    "price_uzs_vip_monthly": {
      "type": "number"
    },
    "price_uzs_vip_yearly": {
      "type": "number"
    },
    "tg_admin_chat_id": {
      "type": "string",
      "description": "The ONE Telegram chat allowed to approve/reject via the payments bot. Set by the /start <code> link flow, never typed in."
    },
    "tg_link_code": {
      "type": "string",
      "description": "One-time code shown on /admin-qr-payments to link the admin's Telegram. Cleared once used."
    },
    "tg_link_expires_at": {
      "type": "string"
    },
    "tg_webhook_secret": {
      "type": "string",
      "description": "Random secret Telegram sends back in X-Telegram-Bot-Api-Secret-Token. Requests without it are dropped."
    },
    "tg_bot_username": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}