{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Why the student is learning English, selected at signup e.g. work, ielts, travel, university, movies, daily"
    },
    "display_name": {
      "type": "string",
      "maxLength": 80,
      "description": "The name the student chose for themselves, shown in the greeting, profile and leaderboard. Exists because the platform's built-in full_name silently ignores writes from the app (updateMe accepts the call and persists every other field in the same payload, but full_name comes back unchanged) \u2014 so full_name is READ-ONLY here and only ever carries what the auth provider supplied. Always read a name via resolveUserName() in src/lib/profileName.js, never full_name directly."
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "description": "The student's current CEFR level. Same ladder as GATES + STARTER_LEVEL in src/lib/placementContent.js \u2014 do not introduce a second level vocabulary. Drives Skill Hub word-pool filtering and game-mode unlocking via src/lib/levels.js."
    },
    "level_source": {
      "type": "string",
      "enum": [
        "self",
        "placement",
        "calibrated",
        "legacy_default"
      ],
      "description": "How cefr_level was arrived at. self = picked during registration; placement = settleAt from the placement test (highest trust); calibrated = adjusted by Skill Hub round performance; legacy_default = backfilled to B1 for accounts that predate the level system (pre 2026-09-04 only)."
    },
    "level_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When cefr_level was last written. Lets a stale self-assessment be re-prompted later without re-testing."
    },
    "cal_up": {
      "type": "number",
      "default": 0,
      "description": "Silent-calibration counter: consecutive Skill Hub rounds scored well above the student's current band. Reaching the promotion threshold proposes a level-up (announced, with undo \u2014 never applied silently, because locked game modes are visible)."
    },
    "cal_down": {
      "type": "number",
      "default": 0,
      "description": "Silent-calibration counter: consecutive rounds scored well below the current band. Counterpart to cal_up."
    },
    "teacher_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "description": "Whether this account is a teacher, and where in the approval flow. Set to 'pending' when someone registers choosing the Teacher role on Register.jsx. Only an admin flips it to 'approved' (via /admin) or 'rejected'. Deliberately separate from the platform's own 'role' field (admin|user, used by Base44's RLS engine) \u2014 teacher-ness is an app concept, not a platform permission, so it never touches 'role'. TeacherDashboard.jsx's access gate checks role === 'admin' OR teacher_status === 'approved'."
    },
    "teacher_status_note": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional admin note on a teacher application, e.g. a reason for rejection. Shown back to the applicant."
    },
    "teacher_commission_rate_pct": {
      "type": "number",
      "description": "Commission rate (percent of what their referred students pay) once approved. Set per-teacher by an admin \u2014 no platform-wide default, since Founder-era rates may vary teacher to teacher."
    },
    "teacher_commission_accrued_usd": {
      "type": "number",
      "default": 0,
      "description": "Running total commission owed to this teacher, in USD. Lives on the teacher's own User row rather than per-TeacherReferral code, because payout happens per teacher, not per code, and a teacher can hold several codes (one per group/class). Incremented when a referred student's payment succeeds \u2014 wiring lands with the Stripe webhook, not yet implemented."
    },
    "teacher_payout_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "paid"
      ],
      "default": "none",
      "description": "Manual payout tracking for MVP \u2014 no automated payout rail yet. An admin marks this 'paid' by hand once a payout is sent, which should also reset teacher_commission_accrued_usd."
    },
    "teacher_last_payout_at": {
      "type": "string",
      "format": "date",
      "description": "Date of the most recent commission payout, set by hand by an admin."
    },
    "teaching_center": {
      "type": "string",
      "maxLength": 120,
      "description": "The school or learning centre this teacher is associated with, typed free-form at registration. Optional \u2014 blank means they teach privately. Shown to an admin when reviewing their teacher application."
    },
    "teacher_phone": {
      "type": "string",
      "maxLength": 40,
      "description": "Teacher's contact phone number, collected at registration. Used to reach them about their application and commission payouts. Deliberately separate from StudentSubscription.phone, which despite its name actually stores an email address."
    },
    "heard_about_us": {
      "type": "string",
      "enum": [
        "instagram",
        "telegram",
        "youtube",
        "friend",
        "teacher",
        "search",
        "other"
      ],
      "description": "Acquisition channel, asked of both students and teachers at registration. A fixed option list rather than free text so it stays countable \u2014 the free-text follow-up lives in heard_about_us_detail."
    },
    "heard_about_us_detail": {
      "type": "string",
      "maxLength": 200,
      "description": "Free-text follow-up captured only when heard_about_us is 'other'."
    },
    "admin_pin_hash": {
      "type": "string",
      "maxLength": 128,
      "description": "SHA-256 of this admin's /admin unlock PIN. IMPORTANT \u2014 this is a convenience lock, NOT a security boundary: the real gate is Base44 auth plus the role-based RLS rules, which are enforced server-side. Anyone holding a valid admin session can call the entity API directly and never sees this screen. A short numeric PIN is also brute-forceable from its hash, so this is only meant to stop a passer-by at an already-unlocked laptop. Never treat it as protection against a technical attacker."
    }
  },
  "required": [
    "role"
  ]
}