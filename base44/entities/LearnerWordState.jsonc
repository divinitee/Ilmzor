{
  "name": "LearnerWordState",
  "type": "object",
  "description": "ONE LEARNER'S standing with ONE WORD: derived rolling summary of WordAttempt (exposure, recognition, recall, usage, mistakes, mastery). One row per (user_email, lemma_key). Learner state lives here, never on VocabularyWord. Readable by the learner and admins only; teachers see roster-scoped summaries through teacherApi.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "lemma_key": {
      "type": "string",
      "description": "normalizeLemma() headword; join key to WordAttempt.word / SavedWord.word."
    },
    "word_id": {
      "type": "string"
    },
    "exposures": {
      "type": "number",
      "default": 0
    },
    "recognition_attempts": {
      "type": "number",
      "default": 0
    },
    "recognition_correct": {
      "type": "number",
      "default": 0
    },
    "recall_attempts": {
      "type": "number",
      "default": 0
    },
    "recall_correct": {
      "type": "number",
      "default": 0
    },
    "usage_attempts": {
      "type": "number",
      "default": 0
    },
    "usage_correct": {
      "type": "number",
      "default": 0
    },
    "correct_streak": {
      "type": "number",
      "default": 0
    },
    "wrong_streak": {
      "type": "number",
      "default": 0
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_correct_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_wrong_at": {
      "type": "string",
      "format": "date-time"
    },
    "mastery": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "mastered"
      ],
      "default": "not_started",
      "description": "Computed by masteryFor() in src/lib/vocab/learnerState.js."
    },
    "weakness_score": {
      "type": "number",
      "default": 0
    },
    "last_game": {
      "type": "string"
    },
    "level_at_last_attempt": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    }
  },
  "required": [
    "user_email",
    "lemma_key"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}