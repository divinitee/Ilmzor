{
  "name": "GrammarAttempt",
  "type": "object",
  "description": "Per-question GRAMMAR PRACTICE evidence, written only by progressApi. Rows with `verification` were graded by the server against base44/shared/grammarKeys.js; rows without it are pre-correction history and are not mastery evidence. Separate from GrammarAssessmentRun (placement).",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "description": "grammar (hub quiz) or grammar_practice (curriculum map)."
    },
    "grammar_topic": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_index": {
      "type": "number"
    },
    "given": {
      "type": "string",
      "maxLength": 200,
      "description": "What the learner answered, for audit."
    },
    "correct": {
      "type": "boolean"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "round_id": {
      "type": "string"
    },
    "round_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "type": "string",
      "enum": [
        "server_graded"
      ]
    }
  },
  "required": [
    "user_email",
    "game",
    "correct",
    "round_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}