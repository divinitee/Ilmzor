{
  "name": "GrammarAttempt",
  "type": "object",
  "description": "Per-question GRAMMAR PRACTICE evidence, written only by progressApi. Rows with `verification` were graded by the server against base44/shared/grammarKeys.js; rows without it are pre-correction history and are not mastery evidence. Separate from GrammarAssessmentRun (placement).",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "description": "grammar (hub quiz) or grammar_practice (curriculum map)."
    },
    "grammar_topic": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_index": {
      "type": "number"
    },
    "given": {
      "type": "string",
      "maxLength": 200,
      "description": "What the learner answered, for audit."
    },
    "correct": {
      "type": "boolean"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "round_id": {
      "type": "string"
    },
    "round_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "type": "string",
      "enum": [
        "server_graded"
      ]
    },
    "bank": {
      "type": "string",
      "description": "Activity bank/mode key (e.g. spelling:typing, usage:collocation_match). Skill Intelligence enrichment; absent on rows written before 2026-09-30."
    },
    "mode": {
      "type": "string",
      "enum": [
        "recognise",
        "construct",
        "produce"
      ],
      "description": "Canonical response mode from base44/shared/skillActivityMap.js at write time (never client-supplied). Informational: classifyEvidence re-derives it."
    },
    "support": {
      "type": "string",
      "enum": [
        "none",
        "hint",
        "unknown"
      ],
      "description": "Client-reported support used on this item (hint = learner opened help). Can only lower a claim."
    },
    "taxonomy_version": {
      "type": "number",
      "description": "TAXONOMY_VERSION of base44/shared/skillTaxonomy.js when the row was written."
    },
    "activity_map_version": {
      "type": "number",
      "description": "ACTIVITY_MAP_VERSION of base44/shared/skillActivityMap.js when the row was written."
    }
  },
  "required": [
    "user_email",
    "game",
    "correct",
    "round_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}