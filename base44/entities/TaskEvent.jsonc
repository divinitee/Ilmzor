{
  "name": "TaskEvent",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "enum": [
        "tee",
        "gpt",
        "claude",
        "fable",
        "base44",
        "system",
        "imported"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "task_code": {
      "type": "string",
      "description": "Code of the task this event belongs to (for step/evidence events, the owning task). Subtree history = task_code equal to X or starting with X + '.'."
    },
    "node_type": {
      "type": "string",
      "enum": [
        "task",
        "step",
        "evidence"
      ]
    },
    "node_code": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    }
  },
  "required": [
    "ts",
    "actor",
    "task_code",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "never"
      }
    },
    "delete": {
      "user_condition": {
        "role": "never"
      }
    }
  }
}
