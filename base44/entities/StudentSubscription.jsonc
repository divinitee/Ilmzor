{
  "name": "StudentSubscription",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "pending",
        "active"
      ],
      "default": "inactive"
    },
    "payment_ref": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "description": "Chosen plan name e.g. VIP Plan, Learner Plan, Starter Plan"
    },
    "referral_code": {
      "type": "string",
      "description": "Teacher's referral code used at registration"
    },
    "teacher_id": {
      "type": "string",
      "description": "ID of the teacher who owns this referral code"
    },
    "teacher_name": {
      "type": "string",
      "description": "Display name of the teacher"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date the active subscription expires (1 month after approval)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    }
  },
  "required": [
    "student_name",
    "phone"
  ]
}