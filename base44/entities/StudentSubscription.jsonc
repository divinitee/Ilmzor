{
  "name": "StudentSubscription",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "pending",
        "active",
        "paused",
        "cancelled"
      ],
      "default": "inactive",
      "description": "inactive = lapsed or never started \u00b7 pending = payment submitted, awaiting approval \u00b7 active = has access \u00b7 paused = admin-suspended, resumable (remaining days held in paused_days_remaining) \u00b7 cancelled = admin-ended deliberately, kept distinct from `inactive` so a cancellation can be told apart from a sub that simply lapsed. Only `active` grants app access \u2014 every gate in the app checks for it explicitly, so any other value fails closed."
    },
    "payment_ref": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "description": "Chosen plan name e.g. VIP Plan, Learner Plan, Starter Plan"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly",
      "description": "Whether the plan is billed monthly or yearly"
    },
    "referral_code": {
      "type": "string",
      "description": "Teacher's referral code used at registration"
    },
    "teacher_id": {
      "type": "string",
      "description": "ID of the teacher who owns this referral code"
    },
    "teacher_name": {
      "type": "string",
      "description": "Display name of the teacher"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date the active subscription expires (1 month or 1 year after approval, based on billing_cycle)"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram chat ID for payment bot notifications"
    },
    "screenshot_verified": {
      "type": "boolean",
      "default": false,
      "description": "AI-verified payment screenshot"
    },
    "is_trial": {
      "type": "boolean",
      "default": false,
      "description": "True if this subscription is the automatic 1-week welcome trial, not a real payment \u2014 used to tell trial expiry apart from a lapsed paid subscription."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    },
    "provider": {
      "type": "string",
      "enum": [
        "manual",
        "dodo"
      ],
      "default": "manual",
      "description": "Which rail owns this subscription. 'manual' = approved by hand by a teacher/admin from a payment screenshot (the legacy Telegram flow). 'dodo' = created and driven by Dodo Payments webhooks. An admin should not hand-edit a 'dodo' row's status: the next webhook will overwrite it, and the two will disagree in the meantime."
    },
    "founder_stage": {
      "type": "string",
      "description": "Which rung of the founder price ladder (lib/founderPricing.js) this subscriber joined on \u2014 'founder', 'early', 'standard'. A label for reporting only: it is supplied by the client at checkout, so never grant anything based on it. The authoritative number is locked_price_usd below."
    },
    "locked_price_usd": {
      "type": "number",
      "description": "The monthly/yearly USD amount this subscriber locked in \u2014 the advertised price they saw and agreed to. Resolved server-side in dodoWebhook by looking up the Dodo product they bought, never from anything the browser claimed. Deliberately NOT read from recurring_pre_tax_amount: VIRORA prices are tax-inclusive, so that figure is the advertised price minus the buyer's local VAT and differs country by country, which would give every subscriber a different 'locked for life' number. Written ONCE on first activation and never overwritten on renewal. If the lookup fails the field is left empty and the next webhook event retries it \u2014 empty is recoverable, a wrong number in a 'for life' field is not."
    },
    "dodo_subscription_id": {
      "type": "string",
      "description": "Dodo Payments subscription id (sub_...). The primary key used to match an incoming webhook back to this row \u2014 more reliable than email, which a customer can change at checkout."
    },
    "dodo_customer_id": {
      "type": "string",
      "description": "Dodo Payments customer id, kept so a returning customer can be matched and for support lookups."
    },
    "last_dodo_event_id": {
      "type": "string",
      "description": "The webhook-id of the last Dodo event applied to this row. Dodo retries deliveries, so this is checked first and a repeat of the same id is skipped \u2014 without it, a retried subscription.renewed would accrue teacher commission twice."
    },
    "paused_at": {
      "type": "string",
      "format": "date",
      "description": "When an admin paused this subscription. Cleared on resume."
    },
    "paused_days_remaining": {
      "type": "number",
      "description": "Days of paid access left at the moment of pausing. Resuming sets expires_at to today + this many days, so a student who paused with 20 days left gets 20 days back rather than losing them to the calendar. Null/0 for a subscription with no expiry (e.g. the permanent free plan)."
    },
    "cancelled_at": {
      "type": "string",
      "format": "date",
      "description": "When an admin cancelled this subscription."
    },
    "admin_note": {
      "type": "string",
      "maxLength": 500,
      "description": "Free-text admin note on the last pause/cancel/reactivate action \u2014 why it happened, for later reconciliation against Stripe or a refund dispute."
    },
    "roster_status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active",
      "description": "Whether this student still appears on their teacher's group roster. Deliberately separate from `status` (payment/access) \u2014 a teacher removing a student here never touches the student's own app access or subscription; it only hides them from that teacher's roster view once they've stopped attending live lessons. Set manually by the teacher, or auto-flagged in the UI (not this field) from SkillHubProgress staleness."
    }
  },
  "required": [
    "student_name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.teacher_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "teacher_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.teacher_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "teacher_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}