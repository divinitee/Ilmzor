{
  "name": "StudentSubscription",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "pending",
        "active"
      ],
      "default": "inactive"
    },
    "payment_ref": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Teacher's referral code used at registration"
    },
    "teacher_id": {
      "type": "string",
      "description": "ID of the teacher who owns this referral code"
    },
    "teacher_name": {
      "type": "string",
      "description": "Display name of the teacher"
    }
  },
  "required": [
    "student_name",
    "phone"
  ]
}