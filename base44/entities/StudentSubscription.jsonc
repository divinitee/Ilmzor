{
  "name": "StudentSubscription",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "pending",
        "active"
      ],
      "default": "inactive"
    },
    "payment_ref": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "description": "Chosen plan name e.g. VIP Plan, Learner Plan, Starter Plan"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly",
      "description": "Whether the plan is billed monthly or yearly"
    },
    "referral_code": {
      "type": "string",
      "description": "Teacher's referral code used at registration"
    },
    "teacher_id": {
      "type": "string",
      "description": "ID of the teacher who owns this referral code"
    },
    "teacher_name": {
      "type": "string",
      "description": "Display name of the teacher"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date the active subscription expires (1 month or 1 year after approval, based on billing_cycle)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    }
  },
  "required": [
    "student_name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}