{
  "name": "StudentSubscription",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "pending",
        "active",
        "paused",
        "cancelled"
      ],
      "default": "inactive",
      "description": "inactive = lapsed or never started \u00b7 pending = payment submitted, awaiting approval \u00b7 active = has access \u00b7 paused = admin-suspended, resumable (remaining days held in paused_days_remaining) \u00b7 cancelled = admin-ended deliberately, kept distinct from `inactive` so a cancellation can be told apart from a sub that simply lapsed. Only `active` grants app access \u2014 every gate in the app checks for it explicitly, so any other value fails closed."
    },
    "payment_ref": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "description": "Chosen plan name e.g. VIP Plan, Learner Plan, Starter Plan"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly",
      "description": "Whether the plan is billed monthly or yearly"
    },
    "referral_code": {
      "type": "string",
      "description": "Teacher's referral code used at registration"
    },
    "teacher_id": {
      "type": "string",
      "description": "ID of the teacher who owns this referral code"
    },
    "teacher_name": {
      "type": "string",
      "description": "Display name of the teacher"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date the active subscription expires (1 month or 1 year after approval, based on billing_cycle)"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram chat ID for payment bot notifications"
    },
    "screenshot_verified": {
      "type": "boolean",
      "default": false,
      "description": "AI-verified payment screenshot"
    },
    "is_trial": {
      "type": "boolean",
      "default": false,
      "description": "True if this subscription is the automatic 1-week welcome trial, not a real payment \u2014 used to tell trial expiry apart from a lapsed paid subscription."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    },
    "paused_at": {
      "type": "string",
      "format": "date",
      "description": "When an admin paused this subscription. Cleared on resume."
    },
    "paused_days_remaining": {
      "type": "number",
      "description": "Days of paid access left at the moment of pausing. Resuming sets expires_at to today + this many days, so a student who paused with 20 days left gets 20 days back rather than losing them to the calendar. Null/0 for a subscription with no expiry (e.g. the permanent free plan)."
    },
    "cancelled_at": {
      "type": "string",
      "format": "date",
      "description": "When an admin cancelled this subscription."
    },
    "admin_note": {
      "type": "string",
      "maxLength": 500,
      "description": "Free-text admin note on the last pause/cancel/reactivate action \u2014 why it happened, for later reconciliation against Stripe or a refund dispute."
    },
    "roster_status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active",
      "description": "Whether this student still appears on their teacher's group roster. Deliberately separate from `status` (payment/access) \u2014 a teacher removing a student here never touches the student's own app access or subscription; it only hides them from that teacher's roster view once they've stopped attending live lessons. Set manually by the teacher, or auto-flagged in the UI (not this field) from SkillHubProgress staleness."
    }
  },
  "required": [
    "student_name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.teacher_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "teacher_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.teacher_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "teacher_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}