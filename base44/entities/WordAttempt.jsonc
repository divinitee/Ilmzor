{
  "name": "WordAttempt",
  "type": "object",
  "description": "Per-word item evidence, one row per vocabulary item answered in a round. Evidence ledger for vocabulary, spelling and comprehension SkillState. Since 2026-09-29 written ONLY by progressApi; rows with `verification` are post-correction evidence, rows without it are pre-correction client-written history (still used for round composition, never for mastery). Always query bounded.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "word": {
      "type": "string",
      "description": "English word as shown (canonical headword when word_id resolves)."
    },
    "word_id": {
      "type": "string",
      "description": "VocabularyWord.id when the word came from the table."
    },
    "game": {
      "type": "string",
      "description": "Game key (GAME_SKILL_MAP)."
    },
    "correct": {
      "type": "boolean"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "round_id": {
      "type": "string"
    },
    "round_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server time the round was accepted; same value as its RoundReceipt.round_at."
    },
    "verification": {
      "type": "string",
      "enum": [
        "server_graded",
        "server_ai",
        "client_attested"
      ],
      "description": "How `correct` was decided."
    }
  },
  "required": [
    "user_email",
    "word",
    "game",
    "correct"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}