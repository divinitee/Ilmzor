{
  "name": "MaterialSegment",
  "properties": {
    "content_text": {
      "type": "string"
    },
    "end_ref": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "learning_topics": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "material_source_id": {
      "type": "string"
    },
    "order_index": {
      "type": "number"
    },
    "segment_type": {
      "enum": [
        "chapter",
        "unit",
        "section",
        "page_range",
        "other"
      ],
      "type": "string"
    },
    "start_ref": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "material_source_id",
    "teacher_id",
    "title",
    "order_index"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}