{
  "name": "SkillHubProgress",
  "type": "object",
  "description": "LEGACY, FROZEN 2026-09-29. The pre-VT-6 client-written peak store. No live code reads or writes it; writes are admin-only so it can no longer be inflated. Kept for history only. Its `best` was copied once into SkillState.legacy_best (display-only, never used for mastery or historical_peak).",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owning student's email"
    },
    "skill": {
      "type": "string",
      "enum": [
        "vocabulary",
        "grammar",
        "spelling",
        "comprehension",
        "creativity"
      ]
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "best": {
      "type": "number",
      "default": 0
    },
    "last": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "skill"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}