{
  "name": "RoundReceipt",
  "type": "object",
  "description": "Exactly-once receipt per (learner, round_id, kind), created only by progressApi via claimRound (earliest-claim election; the platform upsert is not atomic). kind=evidence rows also carry the server-derived round summary the normal SkillState path reads; rebuild recomputes the same numbers from the item ledgers.",
  "properties": {
    "receipt_key": {
      "type": "string",
      "description": "user_email|round_id|kind"
    },
    "claim_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "round_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "evidence",
        "reward"
      ]
    },
    "game": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "claimed",
        "done",
        "rejected"
      ],
      "default": "claimed"
    },
    "round_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server time the claim was made; copied onto every ledger row of the round."
    },
    "items_total": {
      "type": "number"
    },
    "items_credit": {
      "type": "number"
    },
    "verification": {
      "type": "string"
    }
  },
  "required": [
    "receipt_key",
    "user_email",
    "round_id",
    "kind"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}