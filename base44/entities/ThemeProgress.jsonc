{
  "name": "ThemeProgress",
  "type": "object",
  "description": "ONE LEARNER'S progress through ONE curriculum theme (not_started / in_progress / mastered). A cache rebuilt by recomputeThemeProgress() in src/lib/vocab/themeProgress.js from LearnerWordState + ThemeWord. Readable by the learner and admins only; teachers use roster-scoped teacherApi.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "theme_key": {
      "type": "string",
      "description": "VocabTheme.key"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "mastered"
      ],
      "default": "not_started"
    },
    "core_total": {
      "type": "number",
      "default": 0
    },
    "core_mastered": {
      "type": "number",
      "default": 0
    },
    "core_in_progress": {
      "type": "number",
      "default": 0
    },
    "words_practiced": {
      "type": "number",
      "default": 0
    },
    "recycled_mastered": {
      "type": "number",
      "default": 0
    },
    "mastery_pct": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "mastered_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "theme_key"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}