{
  "name": "Feedback",
  "type": "object",
  "description": "Authenticated user feedback. Base44 created_date and created_by_id are the authoritative submission time and reporter identity.",
  "properties": {
    "details": {
      "type": "string",
      "maxLength": 5000
    },
    "current_route": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "details",
    "current_route"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}