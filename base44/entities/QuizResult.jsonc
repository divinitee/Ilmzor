{
  "name": "QuizResult",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "student_phone": {
      "type": "string"
    },
    "unit_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "total_questions": {
      "type": "number",
      "default": 30
    },
    "date": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    },
    "lesson_id": {
      "type": "string",
      "description": "references Lesson.id, populated only when this result came from a Learning Path lesson activity"
    },
    "activity_id": {
      "type": "string",
      "description": "references Activity.id, identifies exactly which check/practice activity produced this result"
    }
  },
  "required": [
    "student_name",
    "student_phone",
    "unit_name",
    "score"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_phone": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}