{
  "name": "AiGradedItem",
  "type": "object",
  "description": "Server-side record of one AI grade, written ONLY by aiApi in the request that ran the grader. Evidence for AI-graded games (sentence -> creativity, definition -> comprehension). progressApi marks a sentence grade counted when its round is submitted; the first grade per round wins.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "round_id": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "enum": [
        "sentence",
        "definition"
      ]
    },
    "item_key": {
      "type": "string"
    },
    "word_id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "description": "0-100 average of the grader's sub-scores."
    },
    "counted": {
      "type": "boolean",
      "default": false,
      "description": "Sentence rows: set by progressApi when the round is accepted as evidence."
    },
    "round_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "round_id",
    "task",
    "score"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}