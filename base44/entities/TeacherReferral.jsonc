{
  "name": "TeacherReferral",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "The unique referral code"
    },
    "label": {
      "type": "string",
      "description": "Optional label for this code e.g. 'Group A Morning'"
    },
    "uses": {
      "type": "number",
      "default": 0,
      "description": "Number of students who used this code"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "description": "CEFR level this group is taught at, e.g. 'B2'. A referral code doubles as a teaching group once this is set."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ]
      },
      "description": "Weekdays this group meets, e.g. [\"Tue\", \"Thu\", \"Sat\"] for a T/T/S schedule"
    },
    "start_time": {
      "type": "string",
      "description": "Class start time, 24h HH:MM, e.g. '09:00'"
    },
    "end_time": {
      "type": "string",
      "description": "Optional class end time, 24h HH:MM"
    },
    "group_status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "ended"
      ],
      "default": "running",
      "description": "Whether this group is currently meeting. The referral code keeps working while running; paused/ended groups are kept for history and hidden from the active roster view by default."
    }
  },
  "required": [
    "teacher_id",
    "code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}