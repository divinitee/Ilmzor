{
  "name": "TeacherReferral",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "The unique join code. Generated server-side by teacherApi.createGroup (uniqueness-checked); never editable afterwards."
    },
    "label": {
      "type": "string",
      "description": "Optional label for this code e.g. 'Group A Morning'"
    },
    "uses": {
      "type": "number",
      "default": 0,
      "description": "Number of students who joined with this code (incremented by studentApi.joinClass)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description"
    },
    "level": {
      "type": "string",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "description": "CEFR level this group is taught at, e.g. 'B2'."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ]
      },
      "description": "Weekdays this group meets, e.g. [\"Tue\", \"Thu\", \"Sat\"]"
    },
    "start_time": {
      "type": "string",
      "description": "Class start time, 24h HH:MM, e.g. '09:00'"
    },
    "end_time": {
      "type": "string",
      "description": "Optional class end time, 24h HH:MM"
    },
    "group_status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "ended"
      ],
      "default": "running",
      "description": "Whether this group is currently meeting. Ended groups refuse new joins and new homework."
    }
  },
  "required": [
    "teacher_id",
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}